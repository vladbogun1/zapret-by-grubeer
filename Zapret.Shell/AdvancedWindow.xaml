<Window x:Class="Zapret.Shell.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Zapret.Shell"
        Title="Запрет by Grubeer"
        Width="1000" Height="720"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FaceText}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Section rail. Present here and nowhere else: the main screen has no navigation by design. -->
        <Style x:Key="RailItem" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,2,8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Fg2}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="R" Background="Transparent" CornerRadius="8" Padding="14,0"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="R" Property="Background" Value="#182B7FE0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="R" Property="Background" Value="#FF13294A" />
                                <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource Cyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title strip -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Face}"
                           FontSize="14.5" FontWeight="SemiBold"
                           Text="{Binding [adv.title], Source={x:Static local:Text.Current}}" />
                <Button Style="{StaticResource CloseCaption}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- rail -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                <RadioButton x:Name="NavStrategies" Style="{StaticResource RailItem}" GroupName="Nav" IsChecked="True"
                             Checked="OnSection" Tag="strategies"
                             Content="{Binding [adv.nav.strategies], Source={x:Static local:Text.Current}}" />
                <RadioButton x:Name="NavServices" Style="{StaticResource RailItem}" GroupName="Nav"
                             Checked="OnSection" Tag="services"
                             Content="{Binding [adv.nav.services], Source={x:Static local:Text.Current}}" />
                <RadioButton x:Name="NavEngine" Style="{StaticResource RailItem}" GroupName="Nav"
                             Checked="OnSection" Tag="engine"
                             Content="{Binding [adv.nav.engine], Source={x:Static local:Text.Current}}" />
                <RadioButton x:Name="NavDiagnostics" Style="{StaticResource RailItem}" GroupName="Nav"
                             Checked="OnSection" Tag="diagnostics"
                             Content="{Binding [adv.nav.diagnostics], Source={x:Static local:Text.Current}}" />

                <TextBlock x:Name="AdminNote" Style="{StaticResource Muted}" Margin="22,18,18,0" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource Warn}" Visibility="Collapsed"
                           Text="{Binding [adv.needAdmin], Source={x:Static local:Text.Current}}" />
            </StackPanel>

            <!-- content -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="8,4,24,20">

                <!-- ===== bypass options ===== -->
                <Grid x:Name="Strategies">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="{Binding [adv.str.hint], Source={x:Static local:Text.Current}}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,14">
                        <Button x:Name="SweepButton" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="0"
                                Padding="18,0" Click="OnFullSweep"
                                Content="{Binding [adv.str.fullSweep], Source={x:Static local:Text.Current}}" />
                        <ProgressBar x:Name="SweepProgress" IsIndeterminate="True" Width="120" Height="4"
                                     Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StrategyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5"
                                                           Foreground="{Binding Brush}" Text="{Binding Note}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Brush}" Text="{Binding Score}" />
                                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Height="32"
                                                    Command="{Binding Use}" IsEnabled="{Binding CanUse}"
                                                    Content="{Binding [adv.str.use], Source={x:Static local:Text.Current}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== services ===== -->
                <Grid x:Name="Services" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,14"
                               Text="{Binding [adv.svc.hint], Source={x:Static local:Text.Current}}" />

                    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ServiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanEdit}"
                                                      Command="{Binding Toggle}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                           Text="{Binding Domains}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Height="30"
                                                    Command="{Binding Remove}" Visibility="{Binding CustomVisibility}"
                                                    Content="{Binding [adv.svc.remove], Source={x:Static local:Text.Current}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding [adv.svc.add], Source={x:Static local:Text.Current}}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4" FontSize="12"
                                       Text="{Binding [adv.svc.name], Source={x:Static local:Text.Current}}" />
                            <TextBox x:Name="NewName" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4" FontSize="12"
                                       Text="{Binding [adv.svc.domains], Source={x:Static local:Text.Current}}" />
                            <TextBox x:Name="NewDomains" Height="84" AcceptsReturn="True" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4" FontSize="12"
                                       Text="{Binding [adv.svc.url], Source={x:Static local:Text.Current}}" />
                            <TextBox x:Name="NewUrl" />
                            <TextBlock x:Name="ServiceError" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Foreground="{StaticResource Bad}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Button x:Name="AddServiceButton" Style="{StaticResource PrimaryButton}" Height="36"
                                    MinWidth="0" Margin="0,14,0,0" Click="OnAddService"
                                    Content="{Binding [adv.svc.add], Source={x:Static local:Text.Current}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== engine ===== -->
                <ScrollViewer x:Name="Engine" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="{Binding [adv.eng.hint], Source={x:Static local:Text.Current}}" />

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding [adv.eng.version], Source={x:Static local:Text.Current}}" />
                                <TextBlock x:Name="EngineVersionText" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding [adv.eng.gameFilter], Source={x:Static local:Text.Current}}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Text="{Binding [adv.eng.gameFilterHint], Source={x:Static local:Text.Current}}" />
                                <ComboBox x:Name="GameFilter" Width="260" HorizontalAlignment="Left"
                                          SelectionChanged="OnGameFilter" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding [adv.eng.ipset], Source={x:Static local:Text.Current}}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Text="{Binding [adv.eng.ipsetHint], Source={x:Static local:Text.Current}}" />
                                <ComboBox x:Name="IpSet" Width="260" HorizontalAlignment="Left" SelectionChanged="OnIpSet" />
                                <Button x:Name="UpdateIpSetButton" Style="{StaticResource QuietButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Click="OnUpdateIpSet"
                                        Content="{Binding [adv.eng.updateIpset], Source={x:Static local:Text.Current}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding [adv.eng.hosts], Source={x:Static local:Text.Current}}" />
                                <TextBlock x:Name="HostsState" Style="{StaticResource Muted}" Margin="0,6,0,10" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ApplyHostsButton" Style="{StaticResource QuietButton}" Click="OnApplyHosts"
                                            Content="{Binding [adv.eng.apply], Source={x:Static local:Text.Current}}" />
                                    <Button x:Name="RemoveHostsButton" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                                            Click="OnRemoveHosts"
                                            Content="{Binding [adv.eng.remove], Source={x:Static local:Text.Current}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== diagnostics ===== -->
                <Grid x:Name="Diagnostics" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="660"
                               HorizontalAlignment="Left"
                               Text="{Binding [adv.diag.hint], Source={x:Static local:Text.Current}}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,14">
                        <Button Style="{StaticResource QuietButton}" Click="OnRefreshDiagnostics"
                                Content="{Binding [adv.diag.refresh], Source={x:Static local:Text.Current}}" />
                        <Button Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="OnCopyDiagnostics"
                                Content="{Binding [adv.diag.copy], Source={x:Static local:Text.Current}}" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
                        <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource Fg2}" FontFamily="Consolas"
                                 FontSize="12.5" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
