<Window x:Class="Zapret.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Zapret.Shell"
        Title="Запрет by Grubeer"
        Width="900" Height="640"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FaceText}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title strip: brand, language, window controls. No navigation, because there is one screen. -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Face}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}"
                               Text="{Binding [app], Source={x:Static local:Text.Current}}" />
                    <TextBlock Margin="6,2,0,0" FontSize="12" Foreground="{StaticResource Fg3}"
                               Text="{Binding [app.by], Source={x:Static local:Text.Current}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Glyphs go in explicit TextBlocks: a ContentPresenter does not reliably pick up the
                         icon font from the button style, and a box instead of an icon is not acceptable. -->
                    <Button Style="{StaticResource Caption}" Width="42" Click="OnLanguage"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{Binding [d.language], Source={x:Static local:Text.Current}}">
                        <TextBlock x:Name="LanguageGlyph" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Fg2}" Text="RU" />
                    </Button>
                    <Button Style="{StaticResource Caption}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}"
                                   Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource CloseCaption}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ onboarding: one question ============ -->
            <Grid x:Name="Onboarding" Grid.Row="1" Margin="40,10,40,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource H1}" TextWrapping="Wrap"
                           Text="{Binding [ob.title], Source={x:Static local:Text.Current}}" />

                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,10,0,22" TextWrapping="Wrap"
                           MaxWidth="620" HorizontalAlignment="Left"
                           Text="{Binding [ob.subtitle], Source={x:Static local:Text.Current}}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSetUp"
                            Content="{Binding [ob.start], Source={x:Static local:Text.Current}}" />
                    <Button Style="{StaticResource QuietButton}" Margin="12,0,0,0" Click="OnSkip"
                            Content="{Binding [ob.skipAll], Source={x:Static local:Text.Current}}" />
                </StackPanel>
            </Grid>

            <!-- ============ the one screen ============ -->
            <Grid x:Name="Status" Grid.Row="1" Margin="40,4,40,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Работает? -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,16,0,0">
                    <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{StaticResource Fg3}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Headline" Style="{StaticResource H1}" Margin="14,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="Subtitle" Grid.Row="1" Style="{StaticResource Muted}" Margin="28,10,0,0"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />

                <!-- 4. Что происходит: real steps, only while working is in progress -->
                <ItemsControl x:Name="Steps" Grid.Row="2" Margin="28,18,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding Brush}" Text="{Binding Glyph}" />
                                <TextBlock Margin="10,0,0,0" Style="{StaticResource Muted}" Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Live facts about the option in use. Shown even in the simple mode: knowing which one is
                     running and how it is doing is not an expert need, it is basic reassurance. -->
                <Border x:Name="MetricsCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,12"
                        Margin="0,20,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{Binding [m.option], Source={x:Static local:Text.Current}}" />
                            <TextBlock x:Name="MetricOption" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Line}" Margin="20,2,20,2" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{Binding [m.uptime], Source={x:Static local:Text.Current}}" />
                            <TextBlock x:Name="MetricUptime" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Line}" Margin="20,2,20,2" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{Binding [m.response], Source={x:Static local:Text.Current}}" />
                            <TextBlock x:Name="MetricResponse" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Line}" Margin="20,2,20,2" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{Binding [m.services], Source={x:Static local:Text.Current}}" />
                            <TextBlock x:Name="MetricServices" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="PickButton" Style="{StaticResource QuietButton}" Margin="24,0,0,0"
                                VerticalAlignment="Center" Click="OnOpenAdvanced"
                                Content="{Binding [m.pick], Source={x:Static local:Text.Current}}" />
                    </StackPanel>
                </Border>

                <!-- 2. Что именно работает -->
                <ItemsControl x:Name="Services" Grid.Row="3" Margin="0,26,0,0" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,10,10" MinWidth="176">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{Binding Brush}" Text="{Binding Glyph}" />
                                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding Name}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" FontSize="12.5"
                                               Foreground="{Binding Brush}" Text="{Binding Verdict}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. Нужно ли что-то делать: advice, then exactly one action -->
                <StackPanel Grid.Row="4">
                    <Border x:Name="AdviceCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Background="#1AE9B949" BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Top"
                                       Foreground="{StaticResource Warn}" Text="&#xE7BA;" />
                            <TextBlock x:Name="AdviceText" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MainAction" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnMainAction" />
                        <Button x:Name="ReportButton" Style="{StaticResource QuietButton}" Margin="12,0,0,0"
                                Visibility="Collapsed" Click="OnCopyReport"
                                Content="{Binding [do.copyReport], Source={x:Static local:Text.Current}}" />
                        <Button x:Name="DetailsButton" Style="{StaticResource QuietButton}" Margin="12,0,0,0"
                                Click="OnToggleDetails"
                                Content="{Binding [do.details], Source={x:Static local:Text.Current}}" />
                    </StackPanel>

                    <!-- Evidence and the only other decision the product ever needs: an update.
                         Expands in place; never navigates away. -->
                    <Border x:Name="Details" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailsText" Style="{StaticResource Muted}" FontFamily="Consolas"
                                       FontSize="12.5" TextWrapping="Wrap" />

                            <Border Background="{StaticResource Line}" Height="1" Margin="0,14,0,14" />

                            <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       MaxWidth="620" HorizontalAlignment="Left" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Height="36"
                                        MinWidth="0" Padding="18,0" Visibility="Collapsed" Click="OnUpdate" />
                                <Button x:Name="CheckButton" Style="{StaticResource QuietButton}" Click="OnCheckUpdates"
                                        Content="{Binding [up.check], Source={x:Static local:Text.Current}}" />
                            </StackPanel>

                            <Border Background="{StaticResource Line}" Height="1" Margin="0,16,0,14" />

                            <CheckBox x:Name="NotificationsBox" Click="OnNotificationsChanged"
                                      Content="{Binding [notify.enabled], Source={x:Static local:Text.Current}}" />

                            <!-- The door to the mechanism. Off by default, and it says plainly who needs it. -->
                            <CheckBox x:Name="AdvancedBox" Margin="0,12,0,0" Click="OnAdvancedChanged"
                                      Content="{Binding [adv.toggle], Source={x:Static local:Text.Current}}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="26,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       MaxWidth="560" HorizontalAlignment="Left"
                                       Text="{Binding [adv.toggleHint], Source={x:Static local:Text.Current}}" />

                            <Button x:Name="AdvancedButton" Style="{StaticResource QuietButton}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed" Click="OnOpenAdvanced"
                                    Content="{Binding [adv.open], Source={x:Static local:Text.Current}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
