<Window x:Class="Zapret.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Zapret.App.Localization"
        Title="Запрет by Grubeer"
        Width="1560" Height="1000"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFontText}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Custom chrome: native resize, snap and maximise behaviour with our own title bar content. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- navigation item: selected state carries a border, a bright icon and a restrained glow -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="10,3,10,3" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource NavHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource NavSelectedBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource GlowBlueSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== sidebar ==================== -->
            <Border Grid.Column="0" Width="{StaticResource SidebarWidth}" Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,16,26">
                        <Grid Width="46" Height="46">
                            <Ellipse Fill="#16233F" />
                            <Ellipse Stroke="{StaticResource AccentCyan}" StrokeThickness="1.2" Opacity="0.7"
                                     Effect="{StaticResource GlowAccent}" />
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE785;"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="23" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding [app.name], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock FontSize="10.5" Margin="1,1,0,0" Foreground="{StaticResource TextMuted}"
                                       Text="{Binding [app.byline], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- navigation -->
                    <ListBox x:Name="Nav" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnNavigationChanged">
                        <ListBoxItem Tag="home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE80F;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.home], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="strategies">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE945;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.strategies], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="services">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE774;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.services], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="diagnostics">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE9D9;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.diagnostics], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="network">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE701;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.network], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE713;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.settings], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Text="&#xE72C;" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding [nav.updates], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- version card: both values are bound, never written into XAML -->
                    <StackPanel Grid.Row="2" Margin="14,10,14,16">
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="{StaticResource GapBottom}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentCyan}" Text="&#xE9D2;" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}"
                                               Text="{Binding [version.engine], Source={x:Static loc:Loc.Instance}}" />
                                    <TextBlock x:Name="EngineVersionText" Style="{StaticResource TextBase}"
                                               FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBlue}" Text="&#xE72E;" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}"
                                               Text="{Binding [version.manager], Source={x:Static loc:Loc.Instance}}" />
                                    <TextBlock x:Name="ManagerVersionText" Style="{StaticResource TextBase}"
                                               FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== content ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- title bar strip: drag area plus tools and caption buttons -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="LanguageButton" Style="{StaticResource ToolButton}" Content="&#xF2B7;"
                                Click="OnToggleLanguage"
                                ToolTip="{Binding [common.language], Source={x:Static loc:Loc.Instance}}" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xEA8F;" Click="OnOpenUpdates"
                                ToolTip="{Binding [tooltip.notifications], Source={x:Static loc:Loc.Instance}}" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE713;" Click="OnOpenSettings"
                                ToolTip="{Binding [tooltip.settings], Source={x:Static loc:Loc.Instance}}" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="OnMaximizeRestore" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" />
                    </StackPanel>
                </Grid>

                <!-- A Frame, not a ContentControl: WPF only allows a Page inside a Window or a Frame.
                     Its own navigation chrome and journal are off — the sidebar is the navigation. -->
                <Frame x:Name="PageHost" Grid.Row="1" Background="Transparent"
                       NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" />

                <!-- bottom status strip -->
                <Border Grid.Row="2" Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="0,9">
                    <StackPanel x:Name="StatusStrip" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{Binding StatusBarBrush}" Text="&#xE72E;" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                   Foreground="{Binding StatusBarBrush}" Text="{Binding StatusBarText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
