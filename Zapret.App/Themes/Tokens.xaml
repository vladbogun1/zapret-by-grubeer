<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:app="clr-namespace:Zapret.App">

    <app:RingDashConverter x:Key="RingConverter" />
    <app:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
        Single source of truth for the visual language. Nothing else in the application defines a colour,
        a radius or a spacing value: everything references these tokens, so the palette can be retuned in
        one place. Dark navy base, electric cyan accent, green for healthy state.
    -->

    <!-- surfaces -->
    <Color x:Key="WindowBackgroundColor">#FF070B14</Color>
    <Color x:Key="SidebarBackgroundColor">#FF0A101C</Color>
    <Color x:Key="CardBackgroundColor">#FF0E1626</Color>
    <Color x:Key="CardBackgroundHoverColor">#FF132034</Color>
    <Color x:Key="CardBackgroundPressedColor">#FF0C1420</Color>
    <Color x:Key="BorderColorValue">#3348688F</Color>
    <Color x:Key="BorderStrongColorValue">#66489CD0</Color>

    <!-- text -->
    <Color x:Key="TextPrimaryColor">#FFEAF2FB</Color>
    <Color x:Key="TextSecondaryColor">#FF8A9BB4</Color>
    <Color x:Key="TextMutedColor">#FF5E6E85</Color>

    <!-- accents -->
    <Color x:Key="AccentBlueColor">#FF2B7FE0</Color>
    <Color x:Key="AccentBlueDeepColor">#FF1B5FB8</Color>
    <Color x:Key="AccentCyanColor">#FF29C7E8</Color>
    <Color x:Key="SuccessGreenColor">#FF25D97A</Color>
    <Color x:Key="SuccessTealColor">#FF1FC8A3</Color>
    <Color x:Key="WarningColorValue">#FFE9B949</Color>
    <Color x:Key="ErrorColorValue">#FFE85C5C</Color>
    <Color x:Key="DisabledColorValue">#FF4A596E</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundHover" Color="{StaticResource CardBackgroundHoverColor}" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="{StaticResource CardBackgroundPressedColor}" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource BorderColorValue}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColorValue}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="SuccessGreen" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessTeal" Color="{StaticResource SuccessTealColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorValue}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColorValue}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColorValue}" />

    <SolidColorBrush x:Key="NavSelectedBackground" Color="#FF13294A" />
    <SolidColorBrush x:Key="NavHoverBackground" Color="#222B7FE0" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentCyanColor}" Offset="0" />
        <GradientStop Color="{StaticResource SuccessGreenColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentBlueColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentBlueDeepColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- geometry and rhythm: 4 / 8 / 12 / 16 / 20 / 24 / 32 -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="PagePadding">18,14,18,14</Thickness>
    <Thickness x:Key="GapBottom">0,0,0,14</Thickness>
    <Thickness x:Key="GapRight">0,0,14,0</Thickness>
    <sys:Double x:Key="SidebarWidth">262</sys:Double>
    <sys:Double x:Key="ControlHeight">38</sys:Double>

    <!-- typography: Segoe UI Variable with a Segoe UI fallback -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="FontHero">30</sys:Double>
    <sys:Double x:Key="FontSection">19</sys:Double>
    <sys:Double x:Key="FontCardTitle">16</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontSecondary">12.5</sys:Double>

    <!-- glow is used sparingly: active status, logo, selected navigation, best result -->
    <DropShadowEffect x:Key="GlowAccent" Color="{StaticResource AccentCyanColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="GlowSuccess" Color="{StaticResource SuccessGreenColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="GlowBlueSoft" Color="{StaticResource AccentBlueColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />

    <!-- ==================== base text ==================== -->

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="TextSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ==================== card ==================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================== buttons ==================== -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource GlowBlueSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardBackgroundHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardBackgroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- flat link-style button used for "Диагностика >" style rows -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SuccessTeal}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- window caption buttons: native proportions, never oversized -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#22FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>
