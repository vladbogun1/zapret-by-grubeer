<Page x:Class="Zapret.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Home">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}">

            <ui:InfoBar x:Name="ServiceBanner"
                        Severity="Warning"
                        Title="Background service is not running"
                        IsClosable="False"
                        Margin="{StaticResource CardMargin}"
                        Visibility="Collapsed" />

            <ui:InfoBar x:Name="ReadOnlyBanner"
                        Severity="Informational"
                        Title="Read-only"
                        Message="You are signed in as a standard user, so the engine cannot be changed from here."
                        IsClosable="False"
                        Margin="{StaticResource CardMargin}"
                        Visibility="Collapsed" />

            <ui:Card Margin="{StaticResource CardMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="StatusText"
                                          Margin="10,0,0,0"
                                          FontTypography="Subtitle"
                                          Text="Checking…" />
                        </StackPanel>

                        <ui:TextBlock x:Name="StatusDetail"
                                      Margin="0,6,0,0"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap"
                                      Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="StartButton"
                                   Content="Start"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Appearance="Primary"
                                   Click="OnStart" />
                        <ui:Button x:Name="StopButton"
                                   Content="Stop"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Margin="8,0,0,0"
                                   Click="OnStop" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:CardExpander Margin="{StaticResource CardMargin}" Header="Engine" IsExpanded="True">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" Text="Flowseal Zapret" />
                        <ui:TextBlock Grid.Column="1" x:Name="EngineVersionText" Text="—" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" Text="Strategy" />
                        <ui:TextBlock Grid.Column="1" x:Name="StrategyText" Text="—" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" Text="Run mode" />
                        <ui:TextBlock Grid.Column="1" x:Name="RunModeText" Text="—" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" Text="Game filter" />
                        <ui:TextBlock Grid.Column="1" x:Name="GameFilterText" Text="—" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" Text="IPSet filter" />
                        <ui:TextBlock Grid.Column="1" x:Name="IpSetText" Text="—" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander x:Name="CompatibilityCard"
                             Margin="{StaticResource CardMargin}"
                             Header="Compatibility notes"
                             Visibility="Collapsed">
                <ui:TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Appearance="Secondary" />
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
