<Page x:Class="Zapret.App.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Lists">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Subtitle" Text="Your lists" />

        <ui:TextBlock Grid.Row="1"
                      Margin="0,4,0,12"
                      Appearance="Secondary"
                      TextWrapping="Wrap"
                      Text="These lists are yours: they are stored outside the engine directory and copied into every engine version, so they survive updates, reinstalls and rollbacks. One entry per line; lines starting with # are comments." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="ListCombo" Width="320" SelectionChanged="OnListChanged">
                <ComboBoxItem Content="Domains to bypass (list-general-user.txt)" Tag="list-general-user.txt" />
                <ComboBoxItem Content="Domains to exclude (list-exclude-user.txt)" Tag="list-exclude-user.txt" />
                <ComboBoxItem Content="Addresses to exclude (ipset-exclude-user.txt)" Tag="ipset-exclude-user.txt" />
            </ComboBox>
            <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" Visibility="Collapsed" />
        </StackPanel>

        <TextBox Grid.Row="3"
                 x:Name="Editor"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 MinHeight="240" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button x:Name="SaveButton"
                       Content="Save and restart engine"
                       Icon="{ui:SymbolIcon Save24}"
                       Appearance="Primary"
                       Click="OnSave" />
            <ui:Button x:Name="ReloadButton" Content="Reload" Margin="8,0,0,0" Click="OnReload" />
            <ui:TextBlock x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center" Appearance="Secondary" Text="" />
        </StackPanel>
    </Grid>
</Page>
