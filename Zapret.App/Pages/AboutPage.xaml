<Page x:Class="Zapret.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <ui:TextBlock FontTypography="Title" Text="Запрет by Grubeer" />
            <ui:TextBlock x:Name="ManagerVersionText" Appearance="Secondary" Margin="0,4,0,20" Text="Version —" />

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Engine" />
                    <ui:TextBlock x:Name="EngineVersionText"
                                  Margin="0,4,0,0"
                                  Appearance="Secondary"
                                  Text="Flowseal Zapret —" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Upstream project" />
                    <ui:TextBlock Margin="0,4,0,8"
                                  TextWrapping="Wrap"
                                  Appearance="Secondary"
                                  Text="The network engine is Flowseal/zapret-discord-youtube, redistributed unmodified under its own MIT licence (Copyright © 2016–2026 bol-van, Copyright © 2024–2026 Flowseal). Запрет by Grubeer is an independent manager and is not affiliated with or endorsed by Flowseal." />
                    <ui:HyperlinkButton Content="github.com/Flowseal/zapret-discord-youtube"
                                        NavigateUri="https://github.com/Flowseal/zapret-discord-youtube" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="This application" />
                    <ui:TextBlock Margin="0,4,0,8"
                                  TextWrapping="Wrap"
                                  Appearance="Secondary"
                                  Text="Запрет by Grubeer — Windows manager, lifecycle controller and updater. Copyright © 2026 Grubeer, MIT licence. The engine's own licence is shipped inside every installed engine version." />
                    <ui:HyperlinkButton x:Name="ManagerRepositoryLink"
                                        Content="Project repository"
                                        NavigateUri="https://github.com/vladbogun1/zapret-by-grubeer" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="WinDivert" />
                    <ui:TextBlock Margin="0,4,0,0"
                                  TextWrapping="Wrap"
                                  Appearance="Secondary"
                                  Text="The engine intercepts packets with WinDivert, distributed under LGPLv3 or GPLv2 at your election. Antivirus software may flag it; that is expected and documented by the upstream project." />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
