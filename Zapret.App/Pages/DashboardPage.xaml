<Page x:Class="Zapret.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Background="Transparent"
      FontFamily="{StaticResource AppFontText}">

    <Page.Resources>
        <!-- one row of the service-check panel -->
        <DataTemplate x:Key="ServiceRow">
            <Grid Margin="0,7,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{Binding StatusBrush}" Text="{Binding Glyph}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource TextSecondaryStyle}" Text="{Binding StatusText}"
                           VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SystemRow">
            <Grid Margin="0,7,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Text="{Binding Glyph}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource TextSecondaryStyle}" Foreground="{Binding ValueBrush}"
                           Text="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EventRow">
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}" Text="{Binding Time}" />
                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource TextBase}" FontSize="12.5"
                           Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ hero ============ -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- brand mark: globe + open lock, the "free internet" idea -->
                <Grid Grid.Column="0" Width="150" Height="150" Margin="0,0,20,0">
                    <Ellipse Width="132" Height="132" Stroke="{StaticResource AccentBlue}" StrokeThickness="1.4" Opacity="0.55" />
                    <Ellipse Width="132" Height="132" Fill="#141F3A" Opacity="0.7" />
                    <Ellipse Width="96" Height="132" Stroke="{StaticResource AccentCyan}" StrokeThickness="0.9" Opacity="0.4" />
                    <Ellipse Width="132" Height="60" Stroke="{StaticResource AccentCyan}" StrokeThickness="0.9" Opacity="0.4" />
                    <Ellipse Width="132" Height="104" Stroke="{StaticResource AccentCyan}" StrokeThickness="0.9" Opacity="0.25" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="46" Text="&#xE785;"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Effect="{StaticResource GlowAccent}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="11" Height="11" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center"
                                 Effect="{StaticResource GlowSuccess}" />
                        <TextBlock Margin="10,0,0,0" FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontHero}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="{Binding HeadlinePrefix}" />
                        <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontHero}" FontWeight="SemiBold"
                                   Foreground="{Binding HeadlineAccentBrush}" Text="{Binding HeadlineAccent}" />
                    </StackPanel>

                    <TextBlock Margin="0,6,0,16" Style="{StaticResource TextSecondaryStyle}" FontSize="13.5"
                               Text="{Binding Subtitle}" TextWrapping="Wrap" />

                    <!-- three compact metric cards -->
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,10" MinWidth="150">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [hero.strategy], Source={x:Static loc:Loc.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                               Text="{Binding StrategyName}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,10" MinWidth="160">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [hero.networkProfile], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                           Text="{Binding NetworkProfile}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,10" MinWidth="140">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [hero.uptime], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                           Text="{Binding Uptime}" />
                            </StackPanel>
                        </Border>
                    </ItemsControl>

                    <!-- primary actions -->
                    <WrapPanel Margin="0,4,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}"
                                Content="{Binding ToggleText}" MinWidth="130" Margin="0,0,10,8" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ProbeCommand}"
                                Content="{Binding [hero.testConnection], Source={x:Static loc:Loc.Instance}}"
                                Margin="0,0,10,8" />
                        <Button Style="{StaticResource SecondaryButton}" IsEnabled="False"
                                Content="{Binding [hero.pickBest], Source={x:Static loc:Loc.Instance}}"
                                ToolTip="{Binding [testing.empty], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ current strategy + quick actions ============ -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="{StaticResource GapBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="{StaticResource GapRight}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [strategy.currentTitle], Source={x:Static loc:Loc.Instance}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- success ring: sweep is data-bound, so an untested strategy shows an empty ring -->
                        <Grid Grid.Column="0" Width="118" Height="118" Margin="0,0,18,0">
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="9" />
                            <Ellipse Stroke="{StaticResource AccentGradient}" StrokeThickness="9"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     StrokeDashArray="{Binding SuccessRatio, Converter={StaticResource RingConverter}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding SuccessRateText}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [strategy.successRate], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding StrategyName}" />
                                <Border Margin="10,2,0,0" VerticalAlignment="Center" Padding="9,3"
                                        Background="#2225D97A" CornerRadius="{StaticResource RadiusPill}">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource SuccessGreen}"
                                               Text="{Binding StrategyBadge}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [strategy.testSuccess], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding TestSuccessText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [strategy.avgResponse], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding AverageResponseText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                           Text="{Binding [strategy.packetLoss], Source={x:Static loc:Loc.Instance}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding PacketLossText}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}" VerticalAlignment="Center"
                                   Text="{Binding LastTestText}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32"
                                Content="{Binding [strategy.details], Source={x:Static loc:Loc.Instance}}"
                                Click="OnOpenDiagnostics" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- quick actions: 2x2 tiles -->
            <Border Grid.Column="1" Style="{StaticResource Card}" MinWidth="272">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [quick.title], Source={x:Static loc:Loc.Instance}}" />
                    <UniformGrid Rows="2" Columns="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Height="78" Margin="0,0,7,7"
                                Command="{Binding ProbeCommand}">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCyan}" Text="&#xE9D9;" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                           Text="{Binding [quick.quickTest], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="78" Margin="7,0,0,7" IsEnabled="False"
                                ToolTip="{Binding [testing.empty], Source={x:Static loc:Loc.Instance}}">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCyan}" Text="&#xE9D5;" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                           Text="{Binding [quick.fullTest], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="78" Margin="0,7,7,0" Click="OnOpenStrategies">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCyan}" Text="&#xE945;" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                           Text="{Binding [quick.pickStrategy], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="78" Margin="7,7,0,0"
                                Command="{Binding RestartServiceCommand}">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCyan}" Text="&#xE72C;" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                           Text="{Binding [quick.restartService], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ strategy testing ============ -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [testing.title], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Text="&#xE946;"
                               ToolTip="{Binding [testing.hint], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>

                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding StrategyResults}" />

                <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                           Text="{Binding [testing.empty], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondaryStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StrategyResults.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ right column ============ -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="330">
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}"
                                   Text="{Binding [services.title], Source={x:Static loc:Loc.Instance}}" />
                        <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ServicesSummaryBrush}" />
                    </Grid>

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Services}"
                                  ItemTemplate="{StaticResource ServiceRow}" />

                    <Button Style="{StaticResource LinkButton}" Margin="0,8,0,0" Command="{Binding ProbeCommand}"
                            Content="{Binding ServicesSummary}" Foreground="{Binding ServicesSummaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [system.title], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SystemRows}"
                                  ItemTemplate="{StaticResource SystemRow}" />
                    <Button Style="{StaticResource LinkButton}" Margin="0,8,0,0" Click="OnOpenDiagnostics"
                            Content="{Binding [system.diagnostics], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [events.title], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventRow}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding [events.empty], Source={x:Static loc:Loc.Instance}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondaryStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
