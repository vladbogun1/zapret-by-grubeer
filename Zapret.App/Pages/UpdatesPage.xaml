<Page x:Class="Zapret.App.Pages.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Background="Transparent"
      FontFamily="{StaticResource AppFontText}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,14"
                       Text="{Binding [nav.updates], Source={x:Static loc:Loc.Instance}}" />

            <Border x:Name="OfflineBanner" Style="{StaticResource Card}" Padding="14,10"
                    Margin="{StaticResource GapBottom}" Visibility="Collapsed"
                    Background="#221F6FE0" BorderBrush="{StaticResource BorderStrongBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentCyan}" Text="&#xE946;" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource TextBase}" TextWrapping="Wrap"
                               Text="{Binding [updates.offline], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <!-- manager -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBlue}" Text="&#xE72E;" />
                            <TextBlock Margin="10,0,0,0" Style="{StaticResource CardTitle}"
                                       Text="{Binding [version.manager], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                       Text="{Binding [updates.installed], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock Grid.Column="1" x:Name="ManagerInstalledText" Style="{StaticResource TextBase}" Text="—" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                       Text="{Binding [updates.latest], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock Grid.Column="1" x:Name="ManagerLatestText" Style="{StaticResource TextBase}" Text="—" />
                        </Grid>

                        <TextBlock x:Name="ManagerStatusText" Margin="0,10,0,0" Style="{StaticResource TextBase}"
                                   TextWrapping="Wrap" Foreground="{StaticResource SuccessGreen}" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="180">
                        <Button x:Name="ManagerCheckButton" Style="{StaticResource SecondaryButton}" Click="OnCheckManager"
                                Content="{Binding [updates.check], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="ManagerUpdateButton" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="OnUpdateManager"
                                Content="{Binding [updates.update], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="ManagerLaterButton" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="OnDismissManager"
                                Content="{Binding [updates.later], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- engine -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyan}" Text="&#xE9D2;" />
                            <TextBlock Margin="10,0,0,0" Style="{StaticResource CardTitle}"
                                       Text="{Binding [version.engine], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                       Text="{Binding [updates.installed], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock Grid.Column="1" x:Name="EngineInstalledText" Style="{StaticResource TextBase}" Text="—" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextSecondaryStyle}"
                                       Text="{Binding [updates.latest], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock Grid.Column="1" x:Name="EngineLatestText" Style="{StaticResource TextBase}" Text="—" />
                        </Grid>

                        <TextBlock x:Name="EngineStatusText" Margin="0,10,0,0" Style="{StaticResource TextBase}"
                                   TextWrapping="Wrap" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="180">
                        <Button x:Name="EngineCheckButton" Style="{StaticResource SecondaryButton}" Click="OnCheckEngine"
                                Content="{Binding [updates.check], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="EngineUpdateButton" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="OnUpdateEngine"
                                Content="{Binding [updates.updateEngine], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="EngineRollbackButton" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                Click="OnRollBackEngine"
                                Content="{Binding [updates.rollback], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="4"
                         Margin="{StaticResource GapBottom}" Visibility="Collapsed" />

            <Border x:Name="NotesCard" Style="{StaticResource Card}" Margin="{StaticResource GapBottom}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [updates.whatsNew], Source={x:Static loc:Loc.Instance}}" />
                    <ScrollViewer MaxHeight="240" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                   FontFamily="Consolas" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [updates.options], Source={x:Static loc:Loc.Instance}}" />
                    <CheckBox x:Name="AutoCheckBox" Margin="0,12,0,6" Click="OnOptionChanged"
                              Content="{Binding [updates.autoCheck], Source={x:Static loc:Loc.Instance}}" />
                    <CheckBox x:Name="NotifyManagerBox" Margin="0,0,0,6" Click="OnOptionChanged"
                              Content="{Binding [updates.notifyManager], Source={x:Static loc:Loc.Instance}}" />
                    <CheckBox x:Name="NotifyEngineBox" Margin="0,0,0,6" Click="OnOptionChanged"
                              Content="{Binding [updates.notifyEngine], Source={x:Static loc:Loc.Instance}}" />
                    <CheckBox x:Name="PreviewBox" Click="OnOptionChanged"
                              Content="{Binding [updates.preview], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
