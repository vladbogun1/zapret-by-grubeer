<Page x:Class="Zapret.App.Pages.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Updates">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <ui:TextBlock FontTypography="Subtitle" Text="Updates" Margin="0,0,0,12" />

            <ui:InfoBar x:Name="OfflineBanner"
                        Severity="Informational"
                        Title="Could not check for updates."
                        Message="The installed engine keeps running; update checking is optional."
                        IsClosable="False"
                        Margin="{StaticResource CardMargin}"
                        Visibility="Collapsed" />

            <!-- Manager -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="Запрет by Grubeer" />
                        <ui:TextBlock x:Name="ManagerInstalledText" Appearance="Secondary" Margin="0,4,0,0" Text="Installed —" />
                        <ui:TextBlock x:Name="ManagerLatestText" Appearance="Secondary" Text="Latest —" />
                        <ui:TextBlock x:Name="ManagerStatusText" Margin="0,6,0,0" Text="" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button x:Name="ManagerCheckButton" Content="Check for updates" Click="OnCheckManager" />
                        <ui:Button x:Name="ManagerUpdateButton"
                                   Content="Update"
                                   Appearance="Primary"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"
                                   Click="OnUpdateManager" />
                        <ui:Button x:Name="ManagerLaterButton"
                                   Content="Later"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"
                                   Click="OnDismissManager" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Engine -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="Flowseal engine" />
                        <ui:TextBlock x:Name="EngineInstalledText" Appearance="Secondary" Margin="0,4,0,0" Text="Installed —" />
                        <ui:TextBlock x:Name="EngineLatestText" Appearance="Secondary" Text="Latest —" />
                        <ui:TextBlock x:Name="EngineStatusText" Margin="0,6,0,0" Text="" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button x:Name="EngineCheckButton" Content="Check for updates" Click="OnCheckEngine" />
                        <ui:Button x:Name="EngineUpdateButton"
                                   Content="Update engine"
                                   Appearance="Primary"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"
                                   Click="OnUpdateEngine" />
                        <ui:Button x:Name="EngineRollbackButton"
                                   Content="Roll back"
                                   Margin="0,8,0,0"
                                   Click="OnRollBackEngine" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ProgressBar x:Name="Progress"
                         Minimum="0" Maximum="1"
                         Height="4"
                         Margin="{StaticResource CardMargin}"
                         Visibility="Collapsed" />

            <ui:CardExpander x:Name="NotesCard" Header="What's new" Margin="{StaticResource CardMargin}" Visibility="Collapsed">
                <ui:TextBlock x:Name="NotesText"
                              TextWrapping="Wrap"
                              Appearance="Secondary"
                              FontFamily="Consolas" />
            </ui:CardExpander>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Options" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoCheckBox" Content="Check for updates automatically" Click="OnOptionChanged" />
                    <CheckBox x:Name="NotifyManagerBox" Content="Notify about new Запрет by Grubeer versions" Click="OnOptionChanged" />
                    <CheckBox x:Name="NotifyEngineBox" Content="Notify about new Flowseal engine versions" Click="OnOptionChanged" />
                    <CheckBox x:Name="PreviewBox" Content="Allow preview releases" Click="OnOptionChanged" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
