<Page x:Class="Zapret.App.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Background="Transparent"
      FontFamily="{StaticResource AppFontText}">

    <Page.Resources>
        <!-- One health check. Status is an icon plus text, never colour alone. -->
        <DataTemplate x:Key="CheckRow">
            <Grid Margin="0,7,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                           Foreground="{Binding Brush}" Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Style="{StaticResource TextBase}" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource TextSecondaryStyle}" Foreground="{Binding Brush}"
                           Text="{Binding Value}" VerticalAlignment="Center" ToolTip="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"
                   Text="{Binding [nav.diagnostics], Source={x:Static loc:Loc.Instance}}" />

        <Grid Grid.Row="1" Margin="{StaticResource GapBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="{StaticResource GapRight}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [diagnostics.checks], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl x:Name="CheckList" Margin="0,10,0,0" ItemTemplate="{StaticResource CheckRow}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [diagnostics.environment], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock x:Name="EnvironmentText" Margin="0,10,0,0" Style="{StaticResource TextSecondaryStyle}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource PrimaryButton}" Click="OnRefresh"
                    Content="{Binding [diagnostics.run], Source={x:Static loc:Loc.Instance}}" />
            <Button x:Name="TestButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnRunTests"
                    Content="{Binding [diagnostics.engineTests], Source={x:Static loc:Loc.Instance}}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnExport"
                    Content="{Binding [diagnostics.export], Source={x:Static loc:Loc.Instance}}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenLogs"
                    Content="{Binding [diagnostics.openLogs], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox x:Name="LogCombo" Width="150" Margin="16,0,0,0" SelectionChanged="OnLogChanged">
                <ComboBoxItem Content="service" Tag="service" />
                <ComboBoxItem Content="manager" Tag="manager" />
                <ComboBoxItem Content="engine" Tag="engine" />
            </ComboBox>
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="4" Margin="14,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="2">
            <TextBox x:Name="LogView" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource TextSecondary}"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Page>
