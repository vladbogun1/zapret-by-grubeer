<Page x:Class="Zapret.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Title="Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <ui:TextBlock FontTypography="Subtitle" Text="Settings" Margin="0,0,0,12" />

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Text="{Binding [common.language], Source={x:Static loc:Loc.Instance}}" />
                    <ui:TextBlock Margin="0,4,0,10" Appearance="Secondary" TextWrapping="Wrap"
                                  Text="{Binding [settings.languageHint], Source={x:Static loc:Loc.Instance}}" />
                    <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left"
                              DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Appearance" />
                    <ui:TextBlock Margin="0,4,0,10" Appearance="Secondary" Text="Follows Windows unless you choose otherwise." />
                    <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Use system setting" Tag="" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Notifications" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="Windows notifications for engine updates, an engine that stopped unexpectedly, and finished strategy tests." />
                    <CheckBox x:Name="NotificationsBox" Content="Show notifications" Click="OnNotificationsChanged" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Locations" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="The application can be installed on any drive. The engine always lives in an ASCII path outside Program Files, because upstream's cygwin-based winws.exe and its scripts are unreliable with Cyrillic or special characters." />
                    <ui:TextBlock x:Name="PathsText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Open engine folder" Click="OnOpenRuntime" />
                        <ui:Button Content="Open data folder" Margin="8,0,0,0" Click="OnOpenData" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Repositories" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="Where updates come from. The manager and the engine are tracked independently." />
                    <ui:TextBlock x:Name="RepositoriesText" FontFamily="Consolas" FontSize="12" Text="" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
