<Page x:Class="Zapret.App.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Background="Transparent"
      FontFamily="{StaticResource AppFontText}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,14"
                       Text="{Binding [nav.network], Source={x:Static loc:Loc.Instance}}" />

            <Border Style="{StaticResource Card}" Margin="{StaticResource GapBottom}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [hero.networkProfile], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock x:Name="ProfileText" Margin="0,8,0,0" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                               Text="{Binding [network.hint], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Adapter" />
                    <TextBlock x:Name="AdapterText" Margin="0,8,0,0" Style="{StaticResource TextBase}"
                               FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
