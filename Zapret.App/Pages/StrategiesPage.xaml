<Page x:Class="Zapret.App.Pages.StrategiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:Zapret.App.Localization"
      Background="Transparent"
      FontFamily="{StaticResource AppFontText}">

    <Page.Resources>
        <!-- One strategy. Score and latency appear only where a sweep actually measured them. -->
        <DataTemplate x:Key="StrategyCard">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{Binding StateBrush}" Text="{Binding Glyph}"
                               ToolTip="{Binding StateText}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15"
                                       Text="{Binding DisplayName}" />

                            <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                    Background="#2225D97A" CornerRadius="{StaticResource RadiusPill}"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" Foreground="{StaticResource SuccessGreen}"
                                           Text="{Binding [strategy.inUse], Source={x:Static loc:Loc.Instance}}" />
                            </Border>

                            <Border Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                    Background="#2229C7E8" CornerRadius="{StaticResource RadiusPill}"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" Foreground="{StaticResource AccentCyan}"
                                           Text="{Binding [strategy.recommended], Source={x:Static loc:Loc.Instance}}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                                   Text="{Binding Detail}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center" MinWidth="90"
                               Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                   Foreground="{Binding ScoreBrush}" Text="{Binding ScoreText}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextSecondaryStyle}"
                                   Text="{Binding LatencyText}" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Height="32" VerticalAlignment="Center"
                            Content="{Binding [strategies.use], Source={x:Static loc:Loc.Instance}}"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                            ToolTip="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}"
                   Text="{Binding [nav.strategies], Source={x:Static loc:Loc.Instance}}" />

        <TextBlock Grid.Row="1" Margin="0,4,0,12" Style="{StaticResource TextSecondaryStyle}" TextWrapping="Wrap"
                   Text="{Binding Subtitle}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding QuickTestCommand}"
                    Content="{Binding [quick.quickTest], Source={x:Static loc:Loc.Instance}}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding FullTestCommand}"
                    Content="{Binding FullTestText}"
                    ToolTip="{Binding [testing.warning], Source={x:Static loc:Loc.Instance}}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding PickBestCommand}"
                    Content="{Binding [testing.useBest], Source={x:Static loc:Loc.Instance}}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnRefresh"
                    Content="{Binding [common.retry], Source={x:Static loc:Loc.Instance}}" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="4" Margin="14,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="StrategyList" ItemTemplate="{StaticResource StrategyCard}" />
        </ScrollViewer>
    </Grid>
</Page>
