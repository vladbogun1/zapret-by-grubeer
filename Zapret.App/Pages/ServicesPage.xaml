<Page x:Class="Zapret.App.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <ui:TextBlock FontTypography="Subtitle" Text="Services and filters" Margin="0,0,0,12" />

            <ui:InfoBar x:Name="ReadOnlyBanner"
                        Severity="Informational"
                        Title="Read-only"
                        Message="Changing these settings requires administrator rights."
                        IsClosable="False"
                        Margin="{StaticResource CardMargin}"
                        Visibility="Collapsed" />

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Run mode" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="How the engine is kept alive. Managed process gives accurate status and captured logs; the Windows service mode is byte-compatible with what upstream's own service.bat installs." />

                    <RadioButton x:Name="ManagedProcessRadio"
                                 GroupName="RunMode"
                                 Content="Managed process (recommended)"
                                 Checked="OnRunModeChanged" />
                    <RadioButton x:Name="WindowsServiceRadio"
                                 GroupName="RunMode"
                                 Content="Windows service named zapret (upstream compatible)"
                                 Checked="OnRunModeChanged" />

                    <CheckBox x:Name="AutostartBox"
                              Margin="0,10,0,0"
                              Content="Start the engine with Windows"
                              Click="OnAutostartChanged" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Game filter" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="Extends the bypass to the high port range games use. Changing it restarts the engine, because the ports are part of its command line." />

                    <ComboBox x:Name="GameFilterCombo" Width="280" HorizontalAlignment="Left" SelectionChanged="OnGameFilterChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="TCP and UDP" />
                        <ComboBoxItem Content="TCP only" />
                        <ComboBoxItem Content="UDP only" />
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="IPSet filter" />
                    <ui:TextBlock Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="Whether the engine restricts itself to upstream's address list. Loaded needs the list to have been downloaded at least once." />

                    <ComboBox x:Name="IpSetCombo" Width="280" HorizontalAlignment="Left" SelectionChanged="OnIpSetChanged">
                        <ComboBoxItem Content="Any address" />
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Loaded list" />
                    </ComboBox>

                    <ui:Button x:Name="UpdateIpSetButton"
                               Margin="0,10,0,0"
                               Content="Update IPSet list"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               HorizontalAlignment="Left"
                               Click="OnUpdateIpSet" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Hosts entries" />
                    <ui:TextBlock x:Name="HostsStateText"
                                  Margin="0,4,0,10"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="ApplyHostsButton" Content="Apply" Click="OnApplyHosts" />
                        <ui:Button x:Name="RemoveHostsButton" Content="Remove" Margin="8,0,0,0" Click="OnRemoveHosts" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
